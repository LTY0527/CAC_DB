-- 在 MySQL 中建立预测结果展示表
CREATE TABLE ads_salary_forecast (
    id INT AUTO_INCREMENT PRIMARY KEY,
    forecast_month VARCHAR(10), -- 存储如 '2026-03'
    predicted_salary DECIMAL(10,2),
    update_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 存储专业匹配度分析结果
CREATE TABLE ads_major_matching_rules (
    id INT AUTO_INCREMENT PRIMARY KEY,
    antecedent VARCHAR(255),  -- 关联前项（如：软件工程）
    consequent VARCHAR(255),  -- 关联后项（如：三大先导）
    confidence DOUBLE,        -- 置信度
    lift DOUBLE,              -- 提升度
    update_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 存储核心 KPI 汇总
CREATE TABLE ads_employment_summary (
    major_name VARCHAR(100),
    avg_salary DECIMAL(10,2),
    matching_rate DOUBLE,
    total_count INT
);


