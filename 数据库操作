#数据库生成语句
CREATE TABLE fact_academic (
    academic_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    student_id BIGINT NOT NULL COMMENT '关联dim_student',
    school_name VARCHAR(100) DEFAULT '上海大学',
    edu_level VARCHAR(50) COMMENT '办学层次 (高职/本科/研究生)',
    degree_name VARCHAR(50) COMMENT '学历名称',
    subject_category VARCHAR(50) COMMENT '学科门类',
    major_code VARCHAR(20) NOT NULL COMMENT '专业代码 (1047类)',
    major_name VARCHAR(100) COMMENT '专业',
    skill_level VARCHAR(50) COMMENT '技能等级',
    certificate_name TEXT COMMENT '证书名称',
    FOREIGN KEY (student_id) REFERENCES dim_student(student_id),
    INDEX idx_major (major_code)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='学籍与培养事实表';

CREATE TABLE fact_employment (
    emp_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    student_id BIGINT NOT NULL,
    destination_code VARCHAR(20) COMMENT '毕业去向代码',
    employer_name VARCHAR(200) COMMENT '单位名称',
    industry_code VARCHAR(50) COMMENT '单位行业 (21类)',
    is_sh_insured TINYINT(1) DEFAULT 0 COMMENT '在沪参保状态',
    avg_salary DECIMAL(10, 2) COMMENT '上年度平均工资',
    first_insured_date DATE COMMENT '首次在沪参保年月',
    leading_industry_tag VARCHAR(100) COMMENT '三大先导产业标记',
    FOREIGN KEY (student_id) REFERENCES dim_student(student_id),
    INDEX idx_industry_salary (industry_code, avg_salary)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='就业监测事实表';
CREATE TABLE dim_company (
    company_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    employer_name VARCHAR(200) UNIQUE NOT NULL COMMENT '单位名称',
    company_scale VARCHAR(50) COMMENT '单位规模',
    is_top_500 TINYINT(1) DEFAULT 0 COMMENT '是否世界/中国500强',
    is_listed TINYINT(1) DEFAULT 0 COMMENT '是否上市',
    strategic_tags JSON COMMENT '存储先导产业/重点领域等标签',
    reg_capital DECIMAL(18, 2) COMMENT '注册资本',
    last_year_revenue DECIMAL(18, 2) COMMENT '上年度营收总额',
    INDEX idx_company_name (employer_name)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='就业单位维度表';

#学生信息脱敏：
CREATE OR REPLACE VIEW v_student_job_analysis AS
SELECT 
    s.student_id,
    -- 姓名脱敏：保留姓氏，名字用星号代替
    CONCAT(LEFT(s.student_name, 1), REPEAT('*', CHAR_LENGTH(s.student_name)-1)) AS masked_name,
    -- 身份证号强脱敏：只保留前4位和后4位
    CONCAT(LEFT(s.id_card, 4), '**********', RIGHT(s.id_card, 4)) AS masked_id,
    s.gender,
    a.major_name,
    a.skill_level,
    e.employer_name,
    e.avg_salary,
    e.leading_industry_tag
FROM dim_student s
JOIN fact_academic a ON s.student_id = a.student_id
JOIN fact_employment e ON s.student_id = e.student_id;

